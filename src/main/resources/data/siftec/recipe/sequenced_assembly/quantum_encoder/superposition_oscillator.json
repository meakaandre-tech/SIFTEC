{
  "type": "create:sequenced_assembly",
  "ingredient": "siftec:superposition_oscillator_core",
  "transitional_item": {
    "id": "siftec:incomplete_superposition_oscillator"
  },
  "result": {
    "id": "siftec:charged_superposition_oscillator"
  },
  "loops": 1,
  "sequence": [
    {
      "type": "create:filling",
      "ingredient": "$ingredient",
      "fluid_ingredient": {
        "type": "fluid_stack",
        "amount": 81000,
        "fluid": "siftec:excited_photonic_matter"
      },
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:dark_matter_crystal",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:crystal_oscillator",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:alclad_aluminum_sheet",
      "results": [
        "$result"
      ]
    }
  ]
}
