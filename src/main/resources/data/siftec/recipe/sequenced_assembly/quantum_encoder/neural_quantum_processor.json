    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:time_crystal",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:supercomputer",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:ficsite_trigon",
      "results": [
        "$result"
      ]
    }
  ]
}
