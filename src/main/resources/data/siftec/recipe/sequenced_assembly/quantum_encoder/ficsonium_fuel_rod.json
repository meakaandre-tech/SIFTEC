{
  "type": "create:sequenced_assembly",
  "ingredient": "siftec:ficsonium_fuel_rod_core",
  "transitional_item": {
    "id": "siftec:incomplete_ficsonium_fuel_rod"
  },
  "result": {
    "id": "siftec:charged_ficsonium_fuel_rod"
  },
  "loops": 1,
  "sequence": [
    {
      "type": "create:filling",
      "ingredient": "$ingredient",
      "fluid_ingredient": {
        "type": "fluid_stack",
        "amount": 64800,
        "fluid": "siftec:excited_photonic_matter"
      },
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:ficsonium",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:electromagnetic_control_rod",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "siftec:ficsite_trigon",
      "results": [
        "$result"
      ]
    }
  ]
}
